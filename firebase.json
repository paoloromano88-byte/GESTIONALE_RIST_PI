{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "ignore": [
      "node_modules",
      "test",
      ".gitignore"
    ],
    "predeploy": [
      "cp \"$PROJECT_DIR/zone-consegna.js\" \"$RESOURCE_DIR/zone-consegna.js\"",
      "cp \"$PROJECT_DIR/comande-escpos.js\" \"$RESOURCE_DIR/comande-escpos.js\""
    ]
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "test/**",
      "functions/**",
      "docs/**",
      "agente-stampa/**",
      "gioco/**",
      "mise-en-place/**",
      "chef-naufrago/**",
      "**/agente-stampa.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8085
    },
    "ui": {
      "enabled": false
    },
    "functions": {
      "port": 5011
    }
  }
}
