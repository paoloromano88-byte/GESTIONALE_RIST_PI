{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "ignore": [
      "node_modules",
      "test",
      ".gitignore"
    ],
    "predeploy": [
      "cp \"$PROJECT_DIR/zone-consegna.js\" \"$RESOURCE_DIR/zone-consegna.js\""
    ]
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "test/**",
      "functions/**",
      "**/.*",
      "**/node_modules/**"
    ]
  },
  "emulators": {
    "firestore": {
      "port": 8085
    },
    "ui": {
      "enabled": false
    },
    "functions": {
      "port": 5011
    }
  }
}
